# Reference only: supply secrets, DB settings and CORS origins externally.
# DB_SSLMODE=verify-full requires a trusted PostgreSQL CA on the server.
APP_NAME="Apixa Laravel Playground"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Artisan development server only. Use --no-reload for multiple workers.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Leave DB_URL empty so it cannot override the discrete PostgreSQL settings.
DB_URL=
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full

FILESYSTEM_DISK=local
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Comma-separated exact origins; no paths or trailing slashes. Wildcard is ignored.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false
