APP_NAME="Apixa Laravel Playground"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Artisan development server only. Use --no-reload for multiple workers.
SERVER_HOST=127.0.0.1
SERVER_PORT=8001
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

# Leave DB_URL empty so it cannot override the discrete PostgreSQL settings.
DB_URL=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=apixa_laravel_test
DB_USERNAME=apixa_dev
DB_PASSWORD=
DB_SSLMODE=prefer

FILESYSTEM_DISK=local
CACHE_STORE=array
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Comma-separated exact origins; no paths or trailing slashes. Wildcard is ignored.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=false
