{
  "name": "@apixa/core",
  "version": "1.0.0-rc.0",
  "description": "TypeScript API framework \u2014 define your API once, use it everywhere.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2mby/apixa.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/a2mby/apixa#readme",
  "bugs": {
    "url": "https://github.com/a2mby/apixa/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "api",
    "fetch",
    "typescript",
    "http",
    "client",
    "framework"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
