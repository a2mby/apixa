{
  "name": "@apixa/mocking",
  "version": "0.5.0",
  "description": "Standalone in-memory mock APIs and local JSON datasets for Apixa — no network, no backend.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/users": {
      "types": "./dist/data/users.d.ts",
      "import": "./dist/data/users.js"
    },
    "./data/users-mock": {
      "types": "./dist/data/users-mock.d.ts",
      "import": "./dist/data/users-mock.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/data/index.ts src/data/users.ts src/data/users-mock.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/node.ts src/data/index.ts src/data/users.ts src/data/users-mock.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apixa/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "apixa",
    "mock",
    "fixtures",
    "in-memory",
    "typescript"
  ]
}
