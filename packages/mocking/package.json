{
  "name": "@apixa/mocking",
  "version": "3.0.0-rc.0",
  "description": "Standalone in-memory mock APIs and local JSON datasets for Apixa \u2014 no network, no backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2mby/apixa.git",
    "directory": "packages/mocking"
  },
  "homepage": "https://github.com/a2mby/apixa#readme",
  "bugs": {
    "url": "https://github.com/a2mby/apixa/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./datasets": {
      "types": "./dist/datasets.d.ts",
      "import": "./dist/datasets.js"
    },
    "./datasets/users": {
      "types": "./dist/dataset-modules/users.d.ts",
      "import": "./dist/dataset-modules/users.js"
    },
    "./datasets/products": {
      "types": "./dist/dataset-modules/products.d.ts",
      "import": "./dist/dataset-modules/products.js"
    },
    "./datasets/companies": {
      "types": "./dist/dataset-modules/companies.d.ts",
      "import": "./dist/dataset-modules/companies.js"
    },
    "./datasets/orders": {
      "types": "./dist/dataset-modules/orders.d.ts",
      "import": "./dist/dataset-modules/orders.js"
    },
    "./datasets/posts": {
      "types": "./dist/dataset-modules/posts.d.ts",
      "import": "./dist/dataset-modules/posts.js"
    },
    "./datasets/comments": {
      "types": "./dist/dataset-modules/comments.d.ts",
      "import": "./dist/dataset-modules/comments.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./src/register.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/datasets.ts src/register.ts src/node.ts src/dataset-modules/users.ts src/dataset-modules/products.ts src/dataset-modules/companies.ts src/dataset-modules/orders.ts src/dataset-modules/posts.ts src/dataset-modules/comments.ts --format esm --dts --clean --external @apixa/core",
    "dev": "tsup src/index.ts src/datasets.ts src/register.ts src/node.ts src/dataset-modules/users.ts src/dataset-modules/products.ts src/dataset-modules/companies.ts src/dataset-modules/orders.ts src/dataset-modules/posts.ts src/dataset-modules/comments.ts --format esm --dts --watch --external @apixa/core",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@apixa/core": "workspace:*",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "apixa",
    "mock",
    "fixtures",
    "in-memory",
    "typescript"
  ],
  "private": true
}
